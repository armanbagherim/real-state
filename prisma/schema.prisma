generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OFFICE_ADMIN
  AGENT
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SharePermission {
  VIEW
  EDIT
  MANAGE
}

enum PropertyStatus {
  ACTIVE
  RENTED
  SOLD
  INACTIVE
  ARCHIVED
}

enum TransactionType {
  RENT
  SALE
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  RENEWED
  CANCELLED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum FollowUpType {
  CALL
  FOLLOW_UP
  CONTRACT
  OWNER
  OTHER
}

enum ReminderStatus {
  PENDING
  COMPLETED
  DISMISSED
}

enum ReminderType {
  CONTRACT_EXPIRY
  FOLLOW_UP
  CALL
  CUSTOM
}

enum SubscriptionStatus {
  AWAITING_RECEIPT
  ACTIVE
  REJECTED
  EXPIRED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

/**
 * Output shapes the ad-copy generator can produce for one property.
 */
enum AdCopyVariant {
  DIVAR
  INSTAGRAM
  WHATSAPP
  CUSTOMER
}

/**
 * Interactions recorded against a shared public listing.
 */
enum PublicListingEventType {
  VIEW
  GALLERY
  PHONE_CLICK
  VISIT_REQUEST
}

model Package {
  id            String         @id @default(cuid())
  name          String
  description   String         @default("")
  monthlyPrice  Int
  yearlyPrice   Int
  propertyLimit Int
  agentLimit    Int
  color         String         @default("#147d70")
  badge         String         @default("")
  internal      Boolean        @default(false)
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@index([active, sortOrder])
}

model Subscription {
  id                String             @id @default(cuid())
  officeId          String
  office            Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  packageId         String
  package           Package            @relation(fields: [packageId], references: [id])
  period            BillingPeriod      @default(MONTHLY)
  status            SubscriptionStatus @default(AWAITING_RECEIPT)
  amount            Int
  receiptPath       String             @default("")
  buyerNote         String             @default("")
  startsAt          DateTime?
  endsAt            DateTime?
  approvedByUserId  String?
  approvedBy        User?              @relation("SubscriptionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  referredByUserId  String?
  referredBy        User?              @relation("SubscriptionReferredBy", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referralCode      String             @default("")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  commissionEntries CommissionEntry[]

  @@index([officeId, status])
  @@index([status])
  @@index([referredByUserId])
}

model CommissionEntry {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  percent        Int
  amount         Int

  @@unique([subscriptionId, userId])
  @@index([userId])
}

model ReferralCode {
  id         String    @id @default(cuid())
  code       String    @unique
  userId     String?   @unique
  user       User?     @relation("UserReferralCode", fields: [userId], references: [id], onDelete: Cascade)
  propertyId String?   @unique
  property   Property? @relation("PropertyReferralCode", fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([propertyId])
}

model Office {
  id                      String         @id @default(cuid())
  name                    String
  phone                   String         @default("")
  address                 String         @default("")
  adminsCanViewAgentFiles Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  users                   User[]
  owners                  Owner[]
  properties              Property[]
  folders                 FilingFolder[]
  settings                Settings?
  subscriptions           Subscription[]

  @@index([name])
}

model User {
  id                    String                  @id @default(cuid())
  name                  String
  username              String                  @unique
  mobile                String                  @unique
  passwordHash          String
  role                  Role                    @default(AGENT)
  status                UserStatus              @default(PENDING)
  commissionPercent     Int                     @default(0)
  officeId              String?
  office                Office?                 @relation(fields: [officeId], references: [id])
  referredByUserId      String?
  referredBy            User?                   @relation("UserReferredBy", fields: [referredByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  sessions              Session[]
  followUps             FollowUp[]
  history               PropertyStatusHistory[]
  ownedProperties       Property[]              @relation("PropertyOwnerUser")
  propertyShares        PropertyShare[]
  createdOwners         Owner[]                 @relation("OwnerCreatedBy")
  approvedUsers         UserApproval[]          @relation("ApprovedBy")
  approvals             UserApproval[]          @relation("ApprovedUser")
  referralCode          ReferralCode?           @relation("UserReferralCode")
  referredUsers         User[]                  @relation("UserReferredBy")
  commissionEntries     CommissionEntry[]
  createdFolders        FilingFolder[]          @relation("FolderCreatedBy")
  folderPins            FilingFolderPin[]
  createdPublicLinks    PropertyPublicLink[]    @relation("PublicLinkCreatedBy")
  createdAdCopies       PropertyAdCopy[]        @relation("AdCopyCreatedBy")
  approvedSubscriptions Subscription[]          @relation("SubscriptionApprovedBy")
  referredSubscriptions Subscription[]          @relation("SubscriptionReferredBy")

  @@index([officeId])
  @@index([status])
  @@index([referredByUserId])
}

model UserApproval {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation("ApprovedUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedByUserId String?
  approvedBy       User?      @relation("ApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  status           UserStatus
  note             String?
  createdAt        DateTime   @default(now())

  @@index([userId, createdAt])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model LoginAttempt {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model Owner {
  id              String          @id @default(cuid())
  officeId        String?
  office          Office?         @relation(fields: [officeId], references: [id])
  createdByUserId String?
  createdByUser   User?           @relation("OwnerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  fullName        String
  mobile          String
  secondMobile    String?
  phone           String?
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  properties      Property[]
  contracts       LeaseContract[]
  followUps       FollowUp[]
  reminders       Reminder[]

  @@index([officeId])
  @@index([createdByUserId])
  @@index([mobile])
  @@index([fullName])
}

model Property {
  id              String                  @id @default(cuid())
  officeId        String?
  office          Office?                 @relation(fields: [officeId], references: [id])
  ownerUserId     String?
  ownerUser       User?                   @relation("PropertyOwnerUser", fields: [ownerUserId], references: [id], onDelete: SetNull)
  sequence        Int                     @unique @default(autoincrement())
  fileCode        String                  @unique
  title           String
  transactionType TransactionType
  propertyType    String
  status          PropertyStatus          @default(ACTIVE)
  city            String
  district        String
  neighborhood    String
  address         String
  area            Decimal                 @db.Decimal(10, 2)
  bedrooms        Int                     @default(0)
  floor           Int                     @default(0)
  totalFloors     Int                     @default(1)
  unitsPerFloor   Int                     @default(1)
  buildingAge     Int                     @default(0)
  parking         Boolean                 @default(false)
  storage         Boolean                 @default(false)
  elevator        Boolean                 @default(false)
  balcony         Boolean                 @default(false)
  salePrice       Decimal                 @default(0) @db.Decimal(18, 0)
  mortgagePrice   Decimal                 @default(0) @db.Decimal(18, 0)
  rentPrice       Decimal                 @default(0) @db.Decimal(18, 0)
  isConvertible   Boolean                 @default(false)
  conversionRate  Decimal?                @db.Decimal(8, 5)
  accessBlockedAt DateTime?
  description     String?
  internalNotes   String?
  source          String?
  sourceUrl       String?
  contactPhone    String?
  ownerId         String
  owner           Owner                   @relation(fields: [ownerId], references: [id])
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  lastFollowUpAt  DateTime?
  deletedAt       DateTime?
  images          PropertyImage[]
  contracts       LeaseContract[]
  history         PropertyStatusHistory[]
  followUps       FollowUp[]
  reminders       Reminder[]
  shares          PropertyShare[]
  folderId        String?
  folder          FilingFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  referralCode    ReferralCode?           @relation("PropertyReferralCode")
  publicLink      PropertyPublicLink?
  adCopies        PropertyAdCopy[]

  @@unique([source, sourceUrl])
  @@index([officeId])
  @@index([ownerUserId])
  @@index([status, deletedAt, createdAt])
  @@index([transactionType, status])
  @@index([ownerId])
  @@index([neighborhood])
  @@index([createdAt])
  @@index([folderId, deletedAt])
}

model FilingFolder {
  id              String            @id @default(cuid())
  officeId        String?
  office          Office?           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  parentId        String?
  parent          FilingFolder?     @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        FilingFolder[]    @relation("FolderTree")
  name            String
  color           String            @default("#147d70")
  sortOrder       Int               @default(0)
  createdByUserId String?
  createdByUser   User?             @relation("FolderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  properties      Property[]
  pins            FilingFolderPin[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([officeId, parentId, sortOrder])
  @@index([officeId, name])
}

model FilingFolderPin {
  id        String       @id @default(cuid())
  folderId  String
  folder    FilingFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([folderId, userId])
  @@index([userId, createdAt])
}

/**
 * A shareable, login-free page for one property. Distinct from `PropertyShare`,
 * which is internal agent-to-agent access inside the office.
 */
model PropertyPublicLink {
  id              String               @id @default(cuid())
  token           String               @unique
  propertyId      String               @unique
  property        Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdByUser   User?                @relation("PublicLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  isActive        Boolean              @default(true)
  showAddress     Boolean              @default(false)
  showPhone       Boolean              @default(true)
  views           Int                  @default(0)
  phoneClicks     Int                  @default(0)
  visitRequests   Int                  @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  events          PublicListingEvent[]

  @@index([isActive])
}

model PublicListingEvent {
  id        String                 @id @default(cuid())
  linkId    String
  link      PropertyPublicLink     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  type      PublicListingEventType
  createdAt DateTime               @default(now())

  @@index([linkId, type])
  @@index([linkId, createdAt])
}

/**
 * Generated ad text per channel. One row per variant keeps the latest text
 * while leaving room for more channels (divar, instagram, whatsapp, ...).
 */
model PropertyAdCopy {
  id              String        @id @default(cuid())
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  variant         AdCopyVariant @default(DIVAR)
  content         String
  generator       String        @default("")
  editedByUser    Boolean       @default(false)
  createdByUserId String?
  createdByUser   User?         @relation("AdCopyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([propertyId, variant])
  @@index([propertyId])
}

model PropertyShare {
  id              String          @id @default(cuid())
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission      SharePermission @default(VIEW)
  canUploadImages Boolean         @default(false)
  canDelete       Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@unique([propertyId, userId])
  @@index([userId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model LeaseContract {
  id                 String         @id @default(cuid())
  propertyId         String
  property           Property       @relation(fields: [propertyId], references: [id])
  ownerId            String
  owner              Owner          @relation(fields: [ownerId], references: [id])
  tenantName         String
  tenantMobile       String
  startDate          DateTime
  endDate            DateTime
  mortgageAmount     Decimal        @db.Decimal(18, 0)
  rentAmount         Decimal        @db.Decimal(18, 0)
  description        String?
  status             ContractStatus @default(ACTIVE)
  previousContractId String?        @unique
  previousContract   LeaseContract? @relation("Renewal", fields: [previousContractId], references: [id])
  nextContract       LeaseContract? @relation("Renewal")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  reminders          Reminder[]

  @@index([propertyId])
  @@index([ownerId])
  @@index([status, endDate])
}

model FollowUp {
  id           String         @id @default(cuid())
  propertyId   String?
  property     Property?      @relation(fields: [propertyId], references: [id])
  ownerId      String?
  owner        Owner?         @relation(fields: [ownerId], references: [id])
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  type         FollowUpType   @default(FOLLOW_UP)
  status       FollowUpStatus @default(PENDING)
  note         String
  followUpDate DateTime
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, followUpDate])
  @@index([propertyId])
  @@index([ownerId])
}

model Reminder {
  id              String         @id @default(cuid())
  propertyId      String?
  property        Property?      @relation(fields: [propertyId], references: [id])
  leaseContractId String?
  leaseContract   LeaseContract? @relation(fields: [leaseContractId], references: [id])
  ownerId         String?
  owner           Owner?         @relation(fields: [ownerId], references: [id])
  title           String
  description     String?
  remindAt        DateTime
  status          ReminderStatus @default(PENDING)
  type            ReminderType   @default(CUSTOM)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, remindAt])
  @@index([propertyId])
  @@index([ownerId])
  @@index([leaseContractId])
}

model PropertyStatusHistory {
  id              String          @id @default(cuid())
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id])
  oldStatus       PropertyStatus?
  newStatus       PropertyStatus
  note            String?
  changedByUserId String
  changedByUser   User            @relation(fields: [changedByUserId], references: [id])
  createdAt       DateTime        @default(now())

  @@index([propertyId, createdAt])
}

model Settings {
  id             String   @id @default("office")
  officeId       String?  @unique
  office         Office?  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  officeName     String   @default("املاک آشیان")
  officePhone    String   @default("")
  officeAddress  String   @default("")
  conversionRate Decimal  @default(0.03) @db.Decimal(8, 5)
  reminderDays   Int[]    @default([60, 30, 14, 7])
  updatedAt      DateTime @updatedAt
}
